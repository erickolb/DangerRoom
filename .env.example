# Create a token in your Metron account's API Tokens section.
METRON_API_TOKEN=
HOST=127.0.0.1
PORT=4340
DATA_DIR=./data
ALLOWED_HOSTS=localhost,127.0.0.1
# Address used by operators for browser access and health checks.
# For HTTPS hosting, use your own instance URL, e.g. https://comics.example.net
# For a custom published host port, include that port here.
DANGERROOM_URL=http://127.0.0.1:4340
# If you use an HTTPS Compose override, persist its selection here:
# COMPOSE_FILE=compose.yaml:compose.https.yaml

# Optional browser sign-in. Leave false for the usual trusted-browser access.
# Generate a random value on Linux: openssl rand -hex 32
# Only needed with REQUIRE_AUTH=true; independent of Android device credentials.
REQUIRE_AUTH=false
DANGERROOM_ADMIN_TOKEN=

# Image storage: local (default) or s3. See docs/s3.md.
IMAGE_STORAGE=local
S3_BUCKET=
AWS_REGION=
S3_PREFIX=dangerroom/covers
# Use AWS roles, AWS_PROFILE, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# Temporary credentials also require AWS_SESSION_TOKEN. Never commit credentials.
