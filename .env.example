# Create a token in your Metron account's API Tokens section.
METRON_API_TOKEN=
HOST=127.0.0.1
PORT=4340
DATA_DIR=./data
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser lockdown. Compose always requires authentication.
# Generate a random value on Linux: openssl rand -hex 32
# Paste it into DANGERROOM_ADMIN_TOKEN, and use it to sign in through HTTPS.
REQUIRE_AUTH=false
DANGERROOM_ADMIN_TOKEN=

# Image storage: local (default) or s3. See docs/s3.md.
IMAGE_STORAGE=local
S3_BUCKET=
AWS_REGION=
S3_PREFIX=dangerroom/covers
# Use AWS roles, AWS_PROFILE, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
# Temporary credentials also require AWS_SESSION_TOKEN. Never commit credentials.
