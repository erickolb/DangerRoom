{
  "name": "dangerroom",
  "version": "0.1.0-alpha.64",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "migrate:covers:s3": "node --env-file-if-exists=.env scripts/migrate-covers-to-s3.mjs",
    "backfill:series-types": "node --env-file-if-exists=.env scripts/backfill-series-types.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0"
  }
}
