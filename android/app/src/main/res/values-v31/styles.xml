<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ef6575</item>
        <item name="android:windowBackground">#190c12</item>
        <item name="android:statusBarColor">#190c12</item>
        <item name="android:navigationBarColor">#190c12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#E7001F</item>
        <item name="android:navigationBarColor">#E7001F</item>
        <item name="android:windowSplashScreenBackground">#E7001F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_badge</item>
    </style>
</resources>
